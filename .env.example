# Use a private, authenticated MongoDB deployment in production (with TLS).
MONGODB_URI=mongodb://127.0.0.1:27017/arclivolabs_employee_portal
# Production: https://workspace.arclivolabs.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Temporary values used only for the one-time bootstrap:admin command.
# Remove these from the production environment after creating the Super Admin.
# Never use NEXT_PUBLIC_ for secrets.
BOOTSTRAP_ADMIN_NAME=ArclivoLabs Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ARL-0001
